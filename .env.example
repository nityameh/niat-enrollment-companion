# Copy to .env.local and fill in. Never commit .env.local.

# Which AI provider to use: anthropic | groq | mock
# If unset, the app uses the first key it finds (Anthropic, then Groq), else mock mode.
# AI_PROVIDER=groq

# --- Groq (free tier: console.groq.com) ---
GROQ_API_KEY=

# GROQ_CHAT_MODEL=openai/gpt-oss-120b     # agent with tools
# GROQ_VISION_MODEL=qwen/qwen3.8-27b      # reads document photos
# GROQ_FAST_MODEL=openai/gpt-oss-20b      # reminders, call briefs

# --- Anthropic Claude (paid: console.anthropic.com) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5            # or claude-haiku-5-5 for the cheapest option
# CLAUDE_EFFORT=medium

# Optional: n8n webhook that receives every reminder (e.g. to send it by email/Telegram)
# N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/enrollment-nudge

# Optional: shared secret n8n sends as the x-cron-secret header to /api/nudges/run
# CRON_SECRET=

# Optional: protect your API budget on the public demo
# MAX_AI_CALLS_PER_DAY=400

# Optional: check every reply against the knowledge base, not only in "company answers only" mode
# GROUNDING_CHECK=always

# --- Optional real WhatsApp (Meta WhatsApp Cloud API, test number) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose
# WHATSAPP_APP_SECRET=          # enables signature checks on incoming webhooks
# WHATSAPP_DEMO_LEAD=ravi       # which demo family a real WhatsApp sender plays (as the parent)
# WHATSAPP_GRAPH_VERSION=v21.0
